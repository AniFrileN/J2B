# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...

# Какой ИИ использовать: gemini (бесплатно) или claude (платно, дёшево)
AI=gemini

# Ключ Gemini: aistudio.google.com -> Get API key (бесплатно, карта не нужна)
GEMINI_API_KEY=

# Ключ Claude: console.anthropic.com -> API Keys (нужен, только если AI=claude)
ANTHROPIC_API_KEY=

# Telegram ID тех, кто может загружать прайсы и делать /itog (через запятую).
# Свой ID бот покажет по команде /start. Пусто = могут все.
ADMIN_IDS=

# Необязательно: модели и файл базы
# GEMINI_MODEL=gemini-3.8-flash
# Запасная модель Gemini, если основная перегружена (пусто — не использовать)
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# CLAUDE_MODEL=claude-haiku-5-5
# DB_PATH=zakup.db
# CURRENCY=₸
